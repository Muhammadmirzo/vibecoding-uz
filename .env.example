# Every env var the code reads: name + one-line purpose. NO real values here, ever.
# Real values live in Vercel (project master-2):  vercel link --yes --project master-2 && vercel env pull .env
# Rule: a missing SECURITY secret must fail closed; a missing optional integration degrades silently (lesson L10).
# New env var → add it here AND check `vercel env ls` for Production + Preview (lesson L16).

# --- Database -----------------------------------------------------------------
DATABASE_URL=                 # REQUIRED. Supabase transaction pooler URL (port 6543). Local: postgres://postgres:postgres@localhost:5432/vibecoding_db
DATABASE_MAX_CONNECTIONS=     # optional. postgres-js pool size per instance (default 10)

# --- Auth & sessions ----------------------------------------------------------
SESSION_SECRET=               # REQUIRED in prod. HMAC key for session cookies (openssl rand -base64 48)
NEXTAUTH_SECRET=              # legacy fallback for SESSION_SECRET only
API_JWT_SECRET=               # signs /api/v1 mobile access tokens
TELEGRAM_LINK_SECRET=         # signs Telegram account-link tokens (falls back to SESSION_SECRET)
ADMIN_EMAIL=                  # scripts/create-admin.ts: first admin email
ADMIN_PHONE=                  # scripts/create-admin.ts: first admin phone
ADMIN_PASSWORD=               # scripts/create-admin.ts: first admin password

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=           # Bot API token (@BotFather). Only source of the token (never site_settings)
TELEGRAM_WEBHOOK_SECRET=      # REQUIRED for the webhook: X-Telegram-Bot-Api-Secret-Token value (fail closed)
TELEGRAM_ADMIN_CHAT_ID=       # chat that receives lead/payment/chat alerts
TELEGRAM_ADMIN_USER_IDS=      # comma-separated Telegram user ids allowed to reply as admin
NEXT_PUBLIC_TELEGRAM_BOT_NAME= # bot username shown in login/deep links
NEXT_PUBLIC_TELEGRAM_WIDGET=  # "1" shows the Telegram login widget in the auth modal

# --- Payments -----------------------------------------------------------------
PAYME_MERCHANT_ID=            # Payme merchant (cashbox) id
PAYME_KEY=                    # Payme merchant key: webhook Basic auth (fail closed)
CLICK_SERVICE_ID=             # Click service id
CLICK_MERCHANT_ID=            # Click merchant id
CLICK_SECRET_KEY=             # Click signing secret (fail closed)

# --- SMS / email --------------------------------------------------------------
ESKIZ_EMAIL=                  # Eskiz.uz SMS login
ESKIZ_PASSWORD=               # Eskiz.uz SMS password
ESKIZ_FROM=                   # optional SMS sender id (default 4546)
RESEND_API_KEY=               # Resend transactional email
RESEND_FROM_EMAIL=            # From: address for Resend

# --- Jobs, rate limits, AI ----------------------------------------------------
CRON_SECRET=                  # REQUIRED for /api/cron/*: Vercel Cron sends Authorization: Bearer <value> (fail closed)
UPSTASH_REDIS_REST_URL=       # optional Redis rate limiter (falls back to Postgres buckets)
UPSTASH_REDIS_REST_TOKEN=     # optional, pairs with the URL above
ANTHROPIC_API_KEY=            # optional. Chat AI agent; missing = AI replies disabled quietly
CHAT_ENABLED=                 # "false" turns the site chat off (default on)
MCP_AUTH_TOKEN=               # mcp-server (stdio) bearer token
MCP_ADMIN_USER_ID=            # mcp-server: user id that MCP writes are attributed to

# --- App / mobile -------------------------------------------------------------
NEXT_PUBLIC_APP_URL=          # public base URL (links in emails, OG)
SUPPORT_EMAIL=                # support email shown in /api/v1/app/config
SUPPORT_PHONE=                # support phone shown in /api/v1/app/config
MIN_APP_VERSION_IOS=          # mobile: below this the API answers "update required"
MIN_APP_VERSION_ANDROID=      # mobile: same for Android
LATEST_APP_VERSION_IOS=       # mobile: latest store version (soft update prompt)
LATEST_APP_VERSION_ANDROID=   # mobile: same for Android
IOS_BUNDLE_ID=                # apple-app-site-association (universal links)
IOS_TEAM_ID=                  # apple-app-site-association team id
ANDROID_PACKAGE=              # assetlinks.json package name
ANDROID_SHA256=               # assetlinks.json signing cert fingerprint

# --- Tooling ------------------------------------------------------------------
E2E_PORT=                     # Playwright dev-server port (default 3000)
# NODE_ENV and CI are set by the platform; do not set them by hand.
