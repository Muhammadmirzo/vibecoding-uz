# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vibecoding_db?sslmode=disable"

# Auth
NEXTAUTH_SECRET="super-secret-random-key-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Telegram Bot
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"
TELEGRAM_ADMIN_CHAT_ID="-100123456789"

# Payments Sandbox / Production
PAYME_MERCHANT_ID="64f123456789"
PAYME_KEY="PaymePrivateKeyFormatHere"
CLICK_SERVICE_ID="12345"
CLICK_MERCHANT_ID="67890"
CLICK_SECRET_KEY="ClickSecretKeyFormatHere"

# SMS Gateway (Eskiz.uz / Play Mobile adapter)
SMS_PROVIDER_API_KEY="sk_live_eskiz_key"
SMS_PROVIDER_EMAIL="info@vibecoding.uz"

# Storage (S3 / Cloudflare R2 / MinIO)
S3_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"
S3_BUCKET_NAME="vibecoding-assets"
S3_ACCESS_KEY_ID="r2_access_key"
S3_SECRET_ACCESS_KEY="r2_secret_key"

# App & Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
